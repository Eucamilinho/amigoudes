# ==============================================================================
# CARPOOLING UNIVERSITARIO UDES - VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================================
# IMPORTANTE:
# - Este archivo es una plantilla de ejemplo. NUNCA coloques credenciales reales aquí.
# - Para desarrollo local, copia este archivo como `.env`:
#     cp .env.example .env
# - En Expo, las variables accesibles desde el cliente deben iniciar con `EXPO_PUBLIC_`.
# - NUNCA agregues claves privadas o de rol de servicio (ej: SUPABASE_SERVICE_ROLE_KEY)
#   en la aplicación móvil del cliente, ya que pueden ser extraídas del paquete.
# ==============================================================================

# Entorno de la aplicación
EXPO_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# SUPABASE (Fase 1 en adelante)
# ------------------------------------------------------------------------------
# URL del proyecto en Supabase (ej: https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clave pública 'anon' de Supabase (con RLS habilitado en el backend)
# NUNCA uses la 'service_role' key en el cliente móvil.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# GOOGLE MAPS PLATFORM (Fase 3 en adelante)
# ------------------------------------------------------------------------------
# Clave de API de Google Maps con restricciones por paquete (Android package name / iOS bundle id)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
