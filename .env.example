# ==============================================================================
# AMIGOUDES - VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================================
# IMPORTANTE:
# - Copia este archivo como `.env` para desarrollo local: cp .env.example .env
# - En Expo, las variables accesibles desde el cliente deben iniciar con `EXPO_PUBLIC_`.
# - NUNCA expongas service_role ni credenciales secretas en la app móvil.
# ==============================================================================

# Entorno de la aplicación
EXPO_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# SUPABASE (Fase 1: Autenticación institucional y PostGIS)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# GOOGLE MAPS PLATFORM (Fase 3: Mapas y Rutas)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
